{
  "manifest_version": 3,
  "name": "LeadHunt",
  "version": "1.0.0",
  "description": "Professional Google Maps lead extractor — scrape, filter, AI email drafts, export CSV/JSON.",
  "permissions": ["activeTab","scripting","storage","tabs"],
  "host_permissions": ["https://www.google.com/maps/*","https://maps.google.com/*","https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"}
  },
  "background": {"service_worker": "src/background.js"},
  "content_scripts": [{
    "matches": ["https://www.google.com/maps/*","https://maps.google.com/*"],
    "js": ["src/content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "web_accessible_resources": [{"resources":["src/*"],"matches":["<all_urls>"]}]
}
